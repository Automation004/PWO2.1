<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Class-Wise Test Suite" verbose="1" preserve-order="true"
	parallel="false">

	<!-- Combined Test: All Master Modules run under a single WebDriver
	session -->
	<test name="Combined Master Test">
		<classes>
			<class name="com.audree.infotech.pwo2.tests.masters.Section">
				<methods>
					<include name="Create" />
				</methods>
			</class>

			<class name="com.audree.infotech.pwo2.tests.masters.TypeOfWork">
				<methods>
					<include name="Create" />
				</methods>
			</class>

			<class
				name="com.audree.infotech.pwo2.tests.masters.FailureObjectTest">
				<methods>
					<include name="Create" />
				</methods>
			</class>

			<class name="com.audree.infotech.pwo2.tests.masters.BlockTest">
				<methods>
					<include name="Create" />
				</methods>
			</class>

			<class name="com.audree.infotech.pwo2.tests.masters.RoomId">
				<methods>
					<include name="Create" />
				</methods>
			</class>

			<class name="com.audree.infotech.pwo2.tests.masters.EquipOrInstId">
				<methods>
					<include name="Create" />
				</methods>
			</class>
		</classes>
	</test>

	<test name="WorkOrderInitiationTest">
		<classes>
			<class
				name="com.audree.infotech.pwo2.tests.Transcations.WorkOrderInitiationTest">
				<methods>
					<include name="createWorkOrder" />
					<exclude name="reInitiateRecord" />
				</methods>
			</class>
		</classes>
	</test>

	<test name="EnInitialReviewTest_QA">
		<classes>
			<class
				name="com.audree.infotech.pwo2.tests.Transcations.EnInitialReviewTest">
				<methods>
					<!--Run All means Include All -->
					<include name="EnInitialReviewWorkFlow" />
					<include name="savingRecord" />
					<include name="submittingRecord" />
					<!--for return using this individual Method only-->
					<exclude name="ReturnRecord" />
				</methods>
			</class>
		</classes>
	</test>

	<test name="EnInitialReviewTest">
		<classes>
			<class
				name="com.audree.infotech.pwo2.tests.Transcations.InitialReviewByQA">
				<methods>
					<include name="initialReviewWorkFlow" />
					<include name="savingRecord" />
					<include name="submittingRecord" />
					<exclude name="ReturnRecord" />
				</methods>
			</class>
		</classes>
	</test>

	<test name="WorkUnderProgressTestCases">
		<classes>
			<class
				name="com.audree.infotech.pwo2.tests.Transcations.WorkUnderProgressTest">
				<methods>
					<include name="WorkUnderProgressSelect" />
					<include name="WorkUnderProgressActivitySave" />

					<include name="WorkUnderProgressSelect" />
					<include name="WorkUnderProgressActivitySubmit" />

					<include name="WorkUnderProgressSelect" />
					<include name="WorkUnderProgressSave" />

					<include name="WorkUnderProgressSelect" />
					<include name="WorkUnderProgressSubmit" />

				</methods>
			</class>
		</classes>
	</test>

	<test name="ImpactAssessmentByUserTest">
		<classes>
			<class
				name="com.audree.infotech.pwo2.tests.Transcations.ImpactAssessmentByUserTest">
				<methods>
					<include name="submittingRecord" />
				</methods>
			</class>
		</classes>
	</test>

	<test name="CategorizationOfWorkTests">
		<classes>
			<class
				name="com.audree.infotech.pwo2.tests.Transcations.CategorizationOfWorkTest">
				<methods>
					<include name="submittingRecord" />
				</methods>
			</class>
		</classes>
	</test>

	<test name="WorkUnderClosureTest">
		<classes>
			<class
				name="com.audree.infotech.pwo2.tests.Transcations.WorkUnderClosure">
				<methods>
					<include name="submittingRecord" />
				</methods>
			</class>
		</classes>
	</test>

	<test name="Closure Initiation Test">
		<classes>
			<class
				name="com.audree.infotech.pwo2.tests.Transcations.ClosureInitiationTest" />
		</classes>
	</test>

	<test name="FinalClosureTest">
		<classes>
			<class
				name="com.audree.infotech.pwo2.tests.Transcations.FinalClosureQATest">
				<methods>
					<include name="submittingRecord" />
					<exclude name="returningRecord" />
				</methods>
			</class>
		</classes>
	</test>
</suite>
